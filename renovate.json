{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "ignoreDeps": [],
  "enabledManagers": [
    "gradle",
    "gradle-wrapper"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "maven"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchDatasources": [
        "maven"
      ],
      "schedule": [
        "before 3am on Monday"
      ],
      "groupName": "Spring Boot",
      "matchPackageNames": [
        "/^org.springframework.boot/"
      ]
    },
    {
      "matchDatasources": [
        "maven"
      ],
      "groupName": "Testing Dependencies",
      "matchPackageNames": [
        "/^org.junit/",
        "/^org.mockito/",
        "/^org.testcontainers/"
      ]
    },
    {
      "matchDatasources": [
        "maven"
      ],
      "groupName": "Database Dependencies",
      "matchPackageNames": [
        "/^org.postgresql/",
        "/^com.h2database/"
      ]
    }
  ],
  "labels": [
    "dependencies",
    "automated"
  ],
  "assignees": [
    "@me"
  ],
  "schedule": [
    "after 10pm every weekday",
    "before 5am every weekday"
  ],
  "timezone": "Europe/Madrid",
  "prConcurrentLimit": 5,
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 3am on Monday"
    ]
  }
}
