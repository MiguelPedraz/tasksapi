{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "ignoreDeps": [],
  "enabledManagers": ["gradle", "gradle-wrapper"],
  "packageRules": [
    {
      "matchDatasources": ["maven"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchDatasources": ["maven"],
      "matchPackagePatterns": ["^org.springframework.boot"],
      "schedule": ["before 3am on Monday"],
      "groupName": "Spring Boot"
    },
    {
      "matchDatasources": ["maven"],
      "matchPackagePatterns": ["^org.junit", "^org.mockito", "^org.testcontainers"],
      "groupName": "Testing Dependencies"
    },
    {
      "matchDatasources": ["maven"],
      "matchPackagePatterns": ["^org.postgresql", "^com.h2database"],
      "groupName": "Database Dependencies"
    }
  ],
  "labels": ["dependencies", "automated"],
  "assignees": ["@me"],
  "schedule": ["after 10pm every weekday", "before 5am every weekday"],
  "timezone": "UTC",
  "prConcurrentLimit": 5,
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on Monday"]
  }
}
