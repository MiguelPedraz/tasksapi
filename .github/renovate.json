{
  "extends": ["config:base"],
  "enabledManagers": ["gradle", "gradle-wrapper"],
  "dependencyDashboard": true,
  "automerge": false,
  "platformAutomerge": false,
  "prConcurrentLimit": 6,
  "branchConcurrentLimit": 6,
  "labels": ["dependencies", "renovate"],
  "semanticCommitScope": "deps",
  "timezone": "Europe/Madrid",
  "packageRules": [
    {
      "matchManagers": ["gradle"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Gradle - actualizaciones no mayores",
      "groupSlug": "gradle-non-major"
    },
    {
      "matchManagers": ["gradle"],
      "matchUpdateTypes": ["major"],
      "groupName": "Gradle - actualizaciones mayores",
      "groupSlug": "gradle-major",
      "schedule": ["before 3am on monday"]
    },
    {
      "matchManagers": ["gradle-wrapper"],
      "groupName": "Gradle Wrapper",
      "groupSlug": "gradle-wrapper"
    }
  ],
  "onboarding": true
}
